# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase — auth + postgres backend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle — Postgres connection string for the Supabase pooler.
# Dashboard → Settings → Database → Connection string → URI (Session pooler).
# Replace [YOUR-PASSWORD] with the project DB password. See db/README.md.
DATABASE_URL=

# SnapTrade — brokerage aggregation / position import
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Public origin used as the Connection Portal callback target, e.g. https://app.example.com
APP_URL=

# Alpaca — live/paper equity curve & market data
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Twelve Data — historical market data / price history
TWELVE_DATA_API_KEY=

# NVIDIA — AI copilot (SJ)
NVIDIA_API_KEY=
